{
  "name": "formula-alchemy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive physics crafting laboratory",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "publish:github": "node scripts/publish-github.mjs",
    "audit:core": "node scripts/audit-core.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "preview:pages": "node scripts/serve-dist.mjs --base /formula-alchemy/ --port 4173"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "matter-js": "0.20.0",
    "katex": "0.16.25"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/matter-js": "0.20.2",
    "@types/katex": "0.16.7",
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "@vitejs/plugin-react": "5.0.4",
    "vitest": "3.2.4",
    "@playwright/test": "1.57.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
